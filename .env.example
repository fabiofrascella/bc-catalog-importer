# BigCommerce demo store credentials
# Store hash is the segment in your API base URL: https://api.bigcommerce.com/stores/<HASH>/v3/
BC_STORE_HASH=your_store_hash

# API account access token. Required scope: "Products (Catalog)" = Modify.
# (Channel/settings read is also used to resolve the channel's category tree.)
BC_ACCESS_TOKEN=your_access_token

# Anthropic API key — used only for the LLM fallback when deterministic
# nav parsing produces a weak/flat tree during --url category scraping. Not
# needed if you always feed a pre-authored catalog JSON via --from-json.
ANTHROPIC_API_KEY=
